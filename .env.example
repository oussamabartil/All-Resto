# LiveKit
LIVEKIT_URL=wss://votre-projet.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Reconnaissance vocale (Deepgram Nova-3)
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=fr

# Synthèse vocale (Cartesia Sonic)
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# Modèle de langage (Claude)
ANTHROPIC_API_KEY=
LLM_MODEL_DEFAULT=claude-haiku-5-5
LLM_MODEL_COMPLEX=claude-sonnet-5-5

# Base de données
DATABASE_URL=postgresql://user:password@localhost:5432/restaurant

# Langue par défaut
DEFAULT_LANGUAGE=fr
